{
  "schema": "airport-connect/rules-v2@1",
  "rule": "Affichage du temps d'attente d'un passage (R-55 corrigée, D-16)",
  "reference": "tools/reference/v2_eta.py",
  "notes": [
    "input.ms_until = heure de départ − maintenant, en millisecondes ; secondes tronquées vers zéro (division entière, comme la v1).",
    "expected.kind : minutes (minutes, blink : « 0 min » clignotant) | imminent (« Imminent ») | hidden (passage retiré de la liste).",
    "Écart avec la v1 (tests/characterization/eta_display.json) : « À l'approche » devient « 0 min » clignotant sur ses 25 dernières secondes, « À l'arrêt » devient « Imminent ». Le théorique est inchangé."
  ],
  "cases": [
    {
      "id": "rt-61s",
      "input": {
        "realtime": true,
        "ms_until": 61000
      },
      "expected": {
        "kind": "minutes",
        "minutes": 2,
        "blink": false
      }
    },
    {
      "id": "rt-60s",
      "input": {
        "realtime": true,
